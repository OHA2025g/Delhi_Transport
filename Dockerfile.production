# ============================================
# Production Dockerfile - Complete Deployment
# This Dockerfile ensures all new KPI features are included
# ============================================

# Stage 1: Backend Builder
FROM python:3.11-slim as backend-builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential gcc g++ make cmake pkg-config \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY backend/requirements.txt .
RUN pip install --no-cache-dir --upgrade pip setuptools wheel && \
    pip install --no-cache-dir -r requirements.txt

# Stage 2: Frontend Builder
FROM node:20-alpine as frontend-builder

WORKDIR /app

COPY frontend/package*.json ./
RUN npm ci --legacy-peer-deps

COPY frontend/ .
# Build with production optimizations
RUN npm run build

# Stage 3: Final Backend Image
FROM python:3.11-slim

# Install runtime dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    tesseract-ocr tesseract-ocr-eng tesseract-ocr-hin \
    libgl1 libglib2.0-0 libsm6 libxext6 libxrender-dev libgomp1 \
    libgthread-2.0-0 libgtk-3-0 \
    libavcodec-dev libavformat-dev libswscale-dev \
    libgstreamer1.0-0 libgstreamer-plugins-base1.0-0 \
    poppler-utils curl wget ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy Python packages from builder
COPY --from=backend-builder /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages
COPY --from=backend-builder /usr/local/bin /usr/local/bin

# Create directories
RUN mkdir -p ./backend/models ./backend/api ./backend/services ./backend/excel ./data/excel ./logs

# Copy backend application code
# Includes new KPI fields: revenue_collected, tax_defaulter_count, accidents
COPY backend/server.py ./backend/
COPY backend/core/ ./backend/core/
COPY backend/utils/ ./backend/utils/
COPY backend/excel/ ./backend/excel/

# Copy data files
COPY data/excel/Vahan1.xlsx ./data/excel/Vahan1.xlsx
COPY data/excel/Tickets.xlsx ./data/excel/Tickets.xlsx
COPY data/excel/transport_extra_kpi_mock_data_FY2025_26.xlsx ./data/excel/transport_extra_kpi_mock_data_FY2025_26.xlsx
COPY data/excel/Parivahan_Dashboard_extra_KPI.xlsx ./data/excel/Parivahan_Dashboard_extra_KPI.xlsx

# Environment variables
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app \
    TESSDATA_PREFIX=/usr/share/tesseract-ocr/5/tessdata \
    TESSERACT_CMD=/usr/bin/tesseract \
    OPENCV_DISABLE_OMP_THREADS=1

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

CMD ["python", "-m", "uvicorn", "backend.server:app", "--host", "0.0.0.0", "--port", "8000"]

